{
  "name": "olfatecario",
  "productName": "Olfatecario",
  "version": "1.0.0",
  "description": "Ferramenta de gestão da Olfatecário",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "backend": "node build-backend.js",
    "dist:win": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.com.olfatecario.app",
    "productName": "Olfatecario",
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": "portable",
      "artifactName": "Olfatecario.exe",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business",
      "identity": "-"
    },
    "dmg": {
      "title": "Olfatecario"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
